import matplotlib.pyplot as plt
import numpy as np

# --- Matplotlib Subplot Examples ---

# 1. Basic Subplot Grid (2x2)
x = np.linspace(0, 10, 100)
y1 = np.sin(x)
y2 = np.cos(x)
y3 = np.tan(x)
y4 = np.exp(x)

plt.figure(figsize=(10, 8))

plt.subplot(2, 2, 1)  # 2x2 grid, 1st subplot
plt.plot(x, y1, label="sin(x)")
plt.title("sin(x)")
plt.grid(True)

plt.subplot(2, 2, 2)  # 2x2 grid, 2nd subplot
plt.plot(x, y2, label="cos(x)", color="red")
plt.title("cos(x)")
plt.grid(True)

plt.subplot(2, 2, 3)  # 2x2 grid, 3rd subplot
plt.plot(x, y3, label="tan(x)", color="green")
plt.title("tan(x)")
plt.grid(True)

plt.subplot(2, 2, 4)  # 2x2 grid, 4th subplot
plt.plot(x, y4, label="exp(x)", color="purple")
plt.title("exp(x)")
plt.grid(True)

plt.tight_layout()  # Adjust subplots to fit into figure area.
plt.show()

# 2. Shared X and Y Axes
plt.figure(figsize=(10, 6))

# Shared X axis
plt.subplot(2, 1, 1)
plt.plot(x, y1, label="sin(x)")
plt.title("Shared X Axis")
plt.grid(True)

plt.subplot(2, 1, 2, sharex=plt.gca())  # Sharing x-axis with the plot above
plt.plot(x, y2, label="cos(x)", color="red")
plt.grid(True)

plt.tight_layout()
plt.show()

# Shared Y axis
plt.figure(figsize=(10, 6))

# Shared Y axis
plt.subplot(1, 2, 1)
plt.plot(x, y1, label="sin(x)")
plt.title("Shared Y Axis")
plt.grid(True)

plt.subplot(1, 2, 2, sharey=plt.gca())  # Sharing y-axis with the plot on the left
plt.plot(x, y2, label="cos(x)", color="red")
plt.grid(True)

plt.tight_layout()
plt.show()

# 3. Subplots with Different Sizes using GridSpec
from matplotlib.gridspec import GridSpec

plt.figure(figsize=(10, 8))
gs = GridSpec(3, 3)

# Create larger subplot
ax1 = plt.subplot(gs[0, :2])
ax1.plot(x, y1, label="sin(x)", color="blue")
ax1.set_title("Larger subplot")
ax1.grid(True)

# Create smaller subplots
ax2 = plt.subplot(gs[0, 2])
ax2.plot(x, y2, label="cos(x)", color="red")
ax2.set_title("Smaller subplot")
ax2.grid(True)

ax3 = plt.subplot(gs[1, :])
ax3.plot(x, y3, label="tan(x)", color="green")
ax3.set_title("Full row subplot")
ax3.grid(True)

ax4 = plt.subplot(gs[2, :2])
ax4.plot(x, y4, label="exp(x)", color="purple")
ax4.set_title("Smaller subplot")
ax4.grid(True)

ax5 = plt.subplot(gs[2, 2])
ax5.plot(x, y1, label="sin(x)", color="orange")
ax5.set_title("Smallest subplot")
ax5.grid(True)

plt.tight_layout()
plt.show()

# 4. Using a For Loop to Plot Multiple Images in Subplots
images = [np.random.rand(10, 10) for _ in range(6)]  # Generate 6 random "images"

plt.figure(figsize=(10, 8))

for i, image in enumerate(images, 1):
    plt.subplot(2, 3, i)  # 2x3 grid, i-th subplot
    plt.imshow(image, cmap='viridis')
    plt.title(f"Image {i}")
    plt.axis("off")  # Hide axes for images

plt.tight_layout()
plt.show()

# 5. Subplots with Different Plot Types
plt.figure(figsize=(10, 8))

# Line plot
plt.subplot(2, 2, 1)
plt.plot(x, y1, label="sin(x)")
plt.title("Line Plot")
plt.grid(True)

# Scatter plot
plt.subplot(2, 2, 2)
plt.scatter(np.random.rand(100), np.random.rand(100), color='green', alpha=0.5)
plt.title("Scatter Plot")
plt.grid(True)

# Bar plot
plt.subplot(2, 2, 3)
categories = ["A", "B", "C", "D"]
values = [5, 7, 3, 4]
plt.bar(categories, values, color='skyblue')
plt.title("Bar Plot")
plt.grid(True)

# Histogram
plt.subplot(2, 2, 4)
data = np.random.randn(1000)
plt.hist(data, bins=30, color='orange', alpha=0.7)
plt.title("Histogram")
plt.grid(True)

plt.tight_layout()
plt.show()

# 6. Subplots with Shared Axes and Individual Adjustments
x1 = np.linspace(0, 5, 100)
x2 = np.linspace(0, 2, 100)
y1 = np.sin(2 * np.pi * x1) * np.exp(-x1)
y2 = np.cos(2 * np.pi * x2)

fig, axs = plt.subplots(2, 1, figsize=(8, 6), sharex=True)  # Sharing x-axis

# Plot 1
axs[0].plot(x1, y1, 'tab:blue')
axs[0].set_title('Damped Sine Wave')
axs[0].grid(True)

# Plot 2
axs[1].plot(x2, y2, 'tab:orange')
axs[1].set_title('Cosine Wave')
axs[1].set_xlabel('Time')
axs[1].grid(True)

# Adjust layout
plt.tight_layout()
plt.show()

# 7. Subplots with Different Colormaps for Images
images = [np.random.rand(10, 10) for _ in range(4)]  # Generate 4 random "images"

cmap_list = ['viridis', 'plasma', 'inferno', 'magma']
plt.figure(figsize=(8, 8))

for i, (image, cmap) in enumerate(zip(images, cmap_list), 1):
    plt.subplot(2, 2, i)  # 2x2 grid, i-th subplot
    plt.imshow(image, cmap=cmap)
    plt.title(f"Cmap: {cmap}")
    plt.axis("off")  # Hide axes for images

plt.tight_layout()
plt.show()
