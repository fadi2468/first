import os
import torch
import cv2
import numpy as np
from torch.utils.data import DataLoader
from torchvision import datasets, transforms
import albumentations as A
from albumentations.pytorch import ToTensorV2
import torch.nn as nn
import torch.optim as optim
import timm
from tqdm import tqdm

# --- Custom Dataset with ImageFolder and Albumentations ---

class AlbumentationsImageFolder(datasets.ImageFolder):
    def __init__(self, root, transform=None):
        super(AlbumentationsImageFolder, self).__init__(root, transform=None)
        self.albumentations_transform = transform

    def __getitem__(self, index):
        path, target = self.samples[index]
        image = cv2.imread(path)

        # Check if the image is grayscale or RGB
        if len(image.shape) == 3:  # Image is in RGB
            image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

        # If using albumentations, convert OpenCV image to numpy array first
        if self.albumentations_transform:
            image = self.albumentations_transform(image=image)['image']

        return image, target


# --- Data Augmentation with Albumentations ---

transform = A.Compose([
    A.Resize(width=224, height=224),
    A.HorizontalFlip(p=0.5),
    A.RandomBrightnessContrast(p=0.5),
    A.Normalize(mean=(0.5,), std=(0.5,)),  # Adjust mean and std for grayscale
    ToTensorV2()
])


# --- DataLoader ---

def get_dataloaders(data_dir, batch_size=8, shuffle=True):
    dataset = AlbumentationsImageFolder(root=data_dir, transform=transform)
    return DataLoader(dataset, batch_size=batch_size, shuffle=shuffle)


# --- Model Definition (Using timm) ---

class ResNet50Model(nn.Module):
    def __init__(self, num_classes):
        super(ResNet50Model, self).__init__()
        self.backbone = timm.create_model('resnet50', pretrained=True, num_classes=0, in_chans=1)  # Set input channels to 1
        self.fc = nn.Linear(self.backbone.num_features, num_classes)  # Output layer with the number of classes

    def forward(self, x):
        x = self.backbone(x)
        x = self.fc(x)
        return x


# --- Training Loop ---

def train(model, dataloader, criterion, optimizer, num_epochs=5, device='cuda'):
    model.to(device)
    model.train()

    for epoch in range(num_epochs):
        epoch_loss = 0.0
        correct = 0
        total = 0
        for images, labels in tqdm(dataloader):
            images, labels = images.to(device), labels.to(device)

            optimizer.zero_grad()
            outputs = model(images)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()

            epoch_loss += loss.item()
            _, predicted = outputs.max(1)
            total += labels.size(0)
            correct += predicted.eq(labels).sum().item()

        print(f'Epoch {epoch + 1}/{num_epochs}, Loss: {epoch_loss / len(dataloader)}, Accuracy: {100.*correct/total:.2f}%')


# --- Main Function ---

def main():
    data_dir = 'path_to_your_data'  # Replace with your data directory, structured for ImageFolder

    # Create DataLoader
    dataloader = get_dataloaders(data_dir, batch_size=8)

    # Determine the number of classes
    num_classes = len(os.listdir(data_dir))

    # Initialize Model, Loss Function, and Optimizer
    model = ResNet50Model(num_classes=num_classes)
    criterion = nn.CrossEntropyLoss()  # CrossEntropyLoss for classification tasks
    optimizer = optim.Adam(model.parameters(), lr=1e-4)

    # Train the Model
    train(model, dataloader, criterion, optimizer, num_epochs=5)

    # Save the model's state_dict
    torch.save(model.state_dict(), 'resnet50_classification.pth')
    print("Model saved as 'resnet50_classification.pth'.")


if __name__ == "__main__":
    main()
