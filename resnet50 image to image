import os
import torch
from torch.utils.data import Dataset, DataLoader, random_split
import albumentations as A
from albumentations.pytorch import ToTensorV2
from PIL import Image
import torch.nn as nn
import torch.optim as optim
import timm
from tqdm import tqdm

# --- Custom Dataset ---

class CustomImageDataset(Dataset):
    def __init__(self, image_dir, label_dir, transform=None):
        self.image_dir = image_dir
        self.label_dir = label_dir
        self.transform = transform
        self.image_files = os.listdir(image_dir)

    def __len__(self):
        return len(self.image_files)

    def __getitem__(self, idx):
        img_path = os.path.join(self.image_dir, self.image_files[idx])
        label_path = os.path.join(self.label_dir, self.image_files[idx])  # Labels are also images

        image = Image.open(img_path)
        label = Image.open(label_path)

        # Convert RGB images to grayscale, keep grayscale images as is
        if image.mode == 'RGB':
            image = image.convert('L')
        if label.mode == 'RGB':
            label = label.convert('L')

        if self.transform:
            augmented = self.transform(image=np.array(image), label=np.array(label))
            image = augmented['image']
            label = augmented['label']

        return image, label


# --- Data Augmentation with Albumentations ---

transform = A.Compose([
    A.Resize(width=224, height=224),
    A.HorizontalFlip(p=0.5),
    A.RandomBrightnessContrast(p=0.5),
    A.Normalize(mean=(0.5,), std=(0.5,)),
    ToTensorV2()
], additional_targets={'label': 'image'})


# --- DataLoader ---

def get_dataloaders(image_dir, label_dir, batch_size=8, valid_size=0.2, shuffle=True):
    dataset = CustomImageDataset(image_dir=image_dir, label_dir=label_dir, transform=transform)
    
    # Split the dataset into training and validation sets
    num_train = int((1 - valid_size) * len(dataset))
    num_valid = len(dataset) - num_train
    train_dataset, val_dataset = random_split(dataset, [num_train, num_valid])
    
    # Create DataLoaders
    train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=shuffle)
    val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False)
    
    return train_loader, val_loader


# --- Model Definition (Using timm) ---

class ResNet50Model(nn.Module):
    def __init__(self):
        super(ResNet50Model, self).__init__()
        self.backbone = timm.create_model('resnet50', pretrained=True, num_classes=0)  # No final layer
        self.fc = nn.Linear(self.backbone.num_features, 224 * 224)  # Flattened label image output (grayscale)

    def forward(self, x):
        x = self.backbone(x)
        x = self.fc(x)
        x = x.view(-1, 1, 224, 224)  # Reshape to grayscale image format (batch_size, 1, height, width)
        return x


# --- Training and Validation Loop ---

def train(model, train_loader, val_loader, criterion, optimizer, num_epochs=5, device='cuda'):
    model.to(device)

    for epoch in range(num_epochs):
        # Training phase
        model.train()
        train_loss = 0.0
        for images, labels in tqdm(train_loader, desc=f"Training Epoch {epoch+1}/{num_epochs}"):
            images, labels = images.to(device), labels.to(device)

            optimizer.zero_grad()
            outputs = model(images)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()

            train_loss += loss.item()

        train_loss /= len(train_loader)
        print(f'Train Loss: {train_loss:.4f}')

        # Validation phase
        model.eval()
        val_loss = 0.0
        with torch.no_grad():
            for images, labels in tqdm(val_loader, desc=f"Validation Epoch {epoch+1}/{num_epochs}"):
                images, labels = images.to(device), labels.to(device)

                outputs = model(images)
                loss = criterion(outputs, labels)

                val_loss += loss.item()

        val_loss /= len(val_loader)
        print(f'Validation Loss: {val_loss:.4f}')


# --- Main Function ---

def main():
    image_dir = 'path_to_your_images'  # Replace with your image directory
    label_dir = 'path_to_your_labels'  # Replace with your label (target) image directory

    # Create DataLoaders
    train_loader, val_loader = get_dataloaders(image_dir, label_dir, batch_size=8)

    # Initialize Model, Loss Function, and Optimizer
    model = ResNet50Model()
    criterion = nn.MSELoss()  # Mean Squared Error since output and label are images
    optimizer = optim.Adam(model.parameters(), lr=1e-4)

    # Train the Model
    train(model, train_loader, val_loader, criterion, optimizer, num_epochs=5)

    # Save the model's state_dict
    torch.save(model.state_dict(), 'resnet50_custom.pth')
    print("Model saved as 'resnet50_custom.pth'.")


if __name__ == "__main__":
    main()
