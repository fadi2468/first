# --- Data Augmentation with Albumentations ---

transform = A.Compose([
    A.Resize(width=224, height=224),
    A.HorizontalFlip(p=0.5),
    A.RandomBrightnessContrast(p=0.5),
    A.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
    ToTensorV2()
], additional_targets={'label': 'image'})


# --- DataLoader ---

def get_dataloaders(image_dir, label_dir, batch_size=8, shuffle=True):
    dataset = CustomImageDataset(image_dir=image_dir, label_dir=label_dir, transform=transform)
    return DataLoader(dataset, batch_size=batch_size, shuffle=shuffle)


# --- Model Definition (Using timm) ---

class ResNet50Model(nn.Module):
    def __init__(self):
        super(ResNet50Model, self).__init__()
        self.backbone = timm.create_model('resnet50', pretrained=True, num_classes=0)  # No final layer
        self.fc = nn.Linear(self.backbone.num_features, 3 * 224 * 224)  # Flattened label image output

    def forward(self, x):
        x = self.backbone(x)
        x = self.fc(x)
        x = x.view(-1, 3, 224, 224)  # Reshape to image format (batch_size, channels, height, width)
        return x


# --- Training Loop ---

def train(model, dataloader, criterion, optimizer, num_epochs=5, device='cuda'):
    model.to(device)
    model.train()

    for epoch in range(num_epochs):
        epoch_loss = 0.0
        for images, labels in tqdm(dataloader):
            images, labels = images.to(device), labels.to(device)

            optimizer.zero_grad()
            outputs = model(images)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()

            epoch_loss += loss.item()

        print(f'Epoch {epoch + 1}/{num_epochs}, Loss: {epoch_loss / len(dataloader)}')


# --- Main Function ---

def main():
    image_dir = 'path_to_your_images'  # Replace with your image directory
    label_dir = 'path_to_your_labels'  # Replace with your label (target) image directory

    # Create DataLoader
    dataloader = get_dataloaders(image_dir, label_dir, batch_size=8)

    # Initialize Model, Loss Function, and Optimizer
    model = ResNet50Model()
    criterion = nn.MSELoss()  # Mean Squared Error since output and label are images
    optimizer = optim.Adam(model.parameters(), lr=1e-4)

    # Train the Model
    train(model, dataloader, criterion, optimizer, num_epochs=5)

    # Save the model's state_dict
    torch.save(model.state_dict(), 'resnet50_custom.pth')
    print("Model saved as 'resnet50_custom.pth'.")


if __name__ == "__main__":
    main()
