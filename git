#!/bin/bash

# --- Basic Git Configuration ---

# Set your Git username
git config --global user.name "Your Name"

# Set your Git email
git config --global user.email "your.email@example.com"

# Set the default editor for Git
git config --global core.editor "your-editor"

# Display the current configuration
git config --list


# --- Initializing a Repository ---

# Initialize a new Git repository in the current directory
git init

# Clone an existing repository from a URL
git clone <repository-url>


# --- Working with Branches ---

# List all branches in your repository
git branch

# Create a new branch
git branch <branch-name>

# Switch to a different branch
git checkout <branch-name>

# Create a new branch and switch to it
git checkout -b <branch-name>

# Merge the specified branch into the current branch
git merge <branch-name>


# --- Tracking and Staging Changes ---

# Show the status of changes as untracked, modified, or staged
git status

# Stage a specific file
git add <file>

# Stage all changes in the current directory
git add .

# Unstage a file
git reset <file>

# Show changes between the working directory and the staging area
git diff


# --- Committing Changes ---

# Commit staged changes with a message
git commit -m "Your commit message"

# Commit all changes, including unstaged ones, with a message
git commit -a -m "Your commit message"


# --- Pushing and Pulling Changes ---

# Push changes to the specified branch on the remote repository
git push origin <branch-name>

# Fetch and merge changes from the remote repository to the current branch
git pull


# --- Remote Repositories ---

# List the current configured remote repositories
git remote -v

# Add a new remote repository
git remote add origin <url>

# Remove a remote repository
git remote remove <name>


# --- Inspecting History ---

# View the commit history
git log

# View the commit history in a compact format
git log --oneline

# Show details of a specific commit
git show <commit-hash>


# --- Undoing Changes ---

# Discard changes in the working directory
git checkout -- <file>

# Create a new commit that undoes the changes from a specific commit
git revert <commit>

# Reset the working directory and staging area to a specific commit
git reset --hard <commit>


# --- Working with Tags ---

# List all tags in the repository
git tag

# Create a new tag
git tag <tag-name>

# Push a tag to the remote repository
git push origin <tag-name>


# --- Git and Conda Environment ---

# Export the environment’s packages list to a text file
conda list --explicit > requirements.txt

# Export the environment to a YAML file
conda env export > environment.yml


# --- Working with Submodules ---

# Add a new submodule
git submodule add <repository-url>

# Initialize the submodules
git submodule init

# Update the submodules to the latest commit
git submodule update
