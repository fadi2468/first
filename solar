import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler, SimpleImputer
from sklearn.decomposition import PCA
from sklearn.model_selection import train_test_split, cross_val_score, KFold
from sklearn.cross_decomposition import PLSRegression
from sklearn.metrics import mean_squared_error
from scipy.signal import savgol_filter
import pickle

# Section 1: Loading and Exploring Data
df = pd.read_excel('AVANTES.xlsx')
print(df.head())
print(df.describe())

# Section 2: Data Preprocessing

# 2.1 Handling Missing Data: Impute missing values (if any)
imputer = SimpleImputer(strategy='mean')
X = df.iloc[:, 13:245].values  # Adjust the column indices based on your dataset
X = imputer.fit_transform(X)  # Impute missing values

# 2.2 Outlier Detection and Removal: Using Z-score method
from scipy.stats import zscore
X_zscores = np.abs(zscore(X))
outliers = np.where(X_zscores > 3)
# Optionally, you can remove these outliers or flag them
# In this example, we’ll remove rows with any outliers
X = np.delete(X, outliers[0], axis=0)
Y = df['Lamination_Time'].values
Y = np.delete(Y, outliers[0], axis=0)

# 2.3 Baseline Correction: Polynomial fitting method
def baseline_correction(spectrum, degree=2):
    """
    Corrects the baseline of a given spectrum by fitting a polynomial of a specified degree.
    
    Parameters:
    - spectrum: 1D numpy array representing the spectrum.
    - degree: Degree of the polynomial used for baseline fitting.
    
    Returns:
    - Corrected spectrum after baseline subtraction.
    """
    x = np.arange(len(spectrum))  # X-axis values (e.g., pixel indices)
    p = np.polyfit(x, spectrum, degree)  # Fit a polynomial of the given degree
    baseline = np.polyval(p, x)  # Evaluate the polynomial (baseline)
    return spectrum - baseline  # Subtract the baseline from the spectrum

# Apply baseline correction to each spectrum
X_corrected = np.array([baseline_correction(spectrum) for spectrum in X])

# 2.4 Denoising/Smoothing: Apply Savitzky-Golay filter to smooth the spectra
X_smooth = savgol_filter(X_corrected, window_length=11, polyorder=3)

# 2.5 Normalization: Normalize each spectrum by its area under the curve
X_normalized = X_smooth / np.sum(X_smooth, axis=1, keepdims=True)

# 2.6 Standardization: Standardize the data (mean = 0, variance = 1)
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X_normalized)

# 2.7 Dimensionality Reduction: Reduce dimensionality using PCA
pca = PCA(n_components=0.95)  # Retain 95% of the variance
X_reduced = pca.fit_transform(X_scaled)

# Section 3: Correlation Matrix
# Calculate the correlation matrix
corr_matrix = np.corrcoef(X_reduced.T)  # Transpose to get features as rows

# Create a heatmap to visualize the correlation matrix
plt.figure(figsize=(12, 10))
sns.heatmap(corr_matrix, annot=False, cmap='coolwarm', fmt='.2f', square=True)
plt.title('Correlation Matrix of the Features')
plt.show()

# Section 4: Creating Separate Training, Validation, and Test Sets
X_train_val, X_test, Y_train_val, Y_test = train_test_split(X_reduced, Y, test_size=0.2, random_state=42)
X_train, X_val, Y_train, Y_val = train_test_split(X_train_val, Y_train_val, test_size=0.25, random_state=42)

# Section 5: Model Training and Validation
pls = PLSRegression(n_components=2)
pls.fit(X_train, Y_train)

Y_val_pred = pls.predict(X_val)
val_r2 = pls.score(X_val, Y_val)
val_rmse = mean_squared_error(Y_val, Y_val_pred, squared=False)
print(f'Validation Set R²: {val_r2:.2f}')
print(f'Validation Set RMSE: {val_rmse:.2f}')

# Section 6: Final Model Training on Full Training Set (Optional)
pls.fit(X_train_val, Y_train_val)

# Section 7: Evaluate the Model on the Test Set
Y_test_pred = pls.predict(X_test)
test_r2 = pls.score(X_test, Y_test)
test_rmse = mean_squared_error(Y_test, Y_test_pred, squared=False)
print(f'Test Set R²: {test_r2:.2f}')
print(f'Test Set RMSE: {test_rmse:.2f}')

# Section 8: Pickling the Final Model
model_filename = 'pls_model.pkl'
with open(model_filename, 'wb') as file:
    pickle.dump(pls, file)

scaler_filename = 'scaler.pkl'
pca_filename = 'pca.pkl'
with open(scaler_filename, 'wb') as file, open(pca_filename, 'wb') as file_pca:
    pickle.dump(scaler, file)
    pickle.dump(pca, file_pca)

print(f'Model saved to {model_filename}')





